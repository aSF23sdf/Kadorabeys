<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B1220">

    <!-- Harita (giriş sonrası) -->
    <WebView
        android:id="@+id/webview"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <!-- Giriş ekranı -->
    <ScrollView
        android:id="@+id/loginBox"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="28dp"
            android:minHeight="560dp">

            <ImageView
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:src="@drawable/ic_launcher"
                android:layout_marginBottom="18dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Admin Paneli"
                android:textColor="#FFFFFF"
                android:textSize="23sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Cihazları görüntülemek için giriş yap"
                android:textColor="#8EA0BA"
                android:textSize="13sp"
                android:layout_marginBottom="28dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card"
                android:padding="18dp">

                <EditText
                    android:id="@+id/adminUser"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Kullanıcı adı"
                    android:text="admin"
                    android:textColor="#E8EEF7"
                    android:textColorHint="#5A6B85"
                    android:background="@drawable/bg_input"
                    android:padding="14dp"
                    android:layout_marginBottom="12dp" />

                <EditText
                    android:id="@+id/adminPass"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Şifre"
                    android:inputType="textPassword"
                    android:textColor="#E8EEF7"
                    android:textColorHint="#5A6B85"
                    android:background="@drawable/bg_input"
                    android:padding="14dp"
                    android:layout_marginBottom="18dp" />

                <Button
                    android:id="@+id/adminLoginBtn"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:text="Giriş Yap"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:background="@drawable/btn_primary" />
            </LinearLayout>

            <TextView
                android:id="@+id/adminErr"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#FF5A5A"
                android:layout_marginTop="16dp" />
        </LinearLayout>
    </ScrollView>
</FrameLayout>
